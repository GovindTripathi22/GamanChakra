# =============================================================================
# GamanChakra v3 — environment
# NO third-party API keys are required. `npm run setup` fills in everything below.
# =============================================================================

# Database (SQLite locally; PostgreSQL in production — change provider in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host:5432/gamanchakra?sslmode=require"

# Local secrets you generate yourself (npm run setup does this)
AUTH_SECRET="replace-with-64-random-hex-chars"
CRON_SECRET="replace-with-random-string"

# Public base URL (used in traveller check-in links)
APP_URL="http://localhost:3000"

# Autonomous agent
AGENT_AUTORUN="true"          # run the agent loop inside the web server
AGENT_INTERVAL_MIN="10"       # minutes between cycles

# Real-time news (all sources are free & keyless)
NEWS_MODE="auto"              # auto | live | drill
NEWS_RETENTION_DAYS="14"
# NEWS_EXTRA_FEEDS="https://example.com/rss.xml,https://another.org/feed"
# NEWS_DISABLED_SOURCES="aljazeera,toi-india"

# Optional: local generative SLM via Ollama (runs on your machine, no key)
# OLLAMA_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="chakra"
# GENERATIVE_SLM="off"

# Optional: accept UPI payments for plan upgrades (your own UPI ID, not an API)
# MERCHANT_VPA="yourbusiness@okhdfcbank"
# MERCHANT_NAME="GamanChakra"

# Optional: comma-separated user ids with admin rights / disable public demo
# ADMIN_USER_ID=""
# DISABLE_DEMO="false"
